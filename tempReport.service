[Unit]
Description=TempReport
After=syslog.target network.target multi-user.target network-online.target

[Service]
SyslogIdentifier=TempReport
Type=simple
User=admin

WorkingDirectory=/home/admin/ThermalControl
cStart=-/usr/bin/python -u /home/admin/ThermalControl/tempReport.py
StandardOutput=journal
Restart=on-failure
RestartSec=10
KillMode=process

[Install]
WantedBy=multi-user.target
