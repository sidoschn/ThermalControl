[Unit]
Description=TempIndicator
After=multi-user.target

[Service]
SyslogIdentifier=TempIndicator
User=admin

WorkingDirectory=/home/admin/ThermalControl
ExecStart=/usr/bin/python /home/admin/ThermalControl/temperatureIndicator.py
StandardOutput=journal
Restart=on-failure
RestartSec=10
KillMode=process

[Install]
WantedBy=multi-user.target
