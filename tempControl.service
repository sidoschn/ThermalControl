[Unit]
Description=TempReport
After=multi-user.target network-online.target

[Service]
SyslogIdentifier=TempReport
User=admin
ExecStart=/usr/bin/python /home/admin/ThermalControl/tempControl.py
StandardOutput=syslog
Restart=on-failure
RestartSec=10
KillMode=process

[Install]
WantedBy=multi-user.target
