[Unit]
Description=TempControl
After=syslog.target network.target multi-user.target

[Service]
SyslogIdentifier=TempControl
Type=simple
User=admin

WorkingDirectory=/home/admin/ThermalControl
ExecStart=-/usr/bin/python -u /home/admin/ThermalControl/tempControl.py
StandardOutput=journal
Restart=always
RestartSec=1

TimeoutSec=20

[Install]
WantedBy=multi-user.target
