[Unit]
Description=TempControl
After=syslog.target network.target multi-user.target network-online.target

[Service]
SyslogIdentifier=TempControl
Type=simple
User=admin

WorkingDirectory=/home/admin/ThermalControl
ExecStart=/usr/bin/python /home/admin/ThermalControl/tempControl.py
StandardOutput=journal
Restart=on-failure
RestartSec=10
KillMode=process

[Install]
WantedBy=multi-user.target
